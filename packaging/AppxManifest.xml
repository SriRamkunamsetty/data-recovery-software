<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="RecoverXForensics"
    ProcessorArchitecture="x64"
    Publisher="CN=RecoverXForensics"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>RecoverX</DisplayName>
    <PublisherDisplayName>RecoverX Open Source</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Forensic Removable Storage Data Recovery and Carving Suite for Windows.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="RecoverX" Executable="recoverx.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="RecoverX"
        Description="Recover lost, deleted, and damaged files from removable storage media."
        BackgroundColor="#0B1120"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="RecoverX" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B1120" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
